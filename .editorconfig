root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = tab
indent_size = 4

[*.bat]
end_of_line = crlf

[assets/levels/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false
